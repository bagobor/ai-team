{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QA Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results",
    "bugs",
    "summary"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ac",
          "status",
          "commands",
          "notes"
        ],
        "properties": {
          "ac": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passing",
              "failing"
            ]
          },
          "commands": {
            "description": "Exact shell commands, each one as a shell would run it, never a description. The engine runs every entry as written. One the shell can't find sends this attempt back, and one that fails fails the criterion.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ac",
          "title",
          "description",
          "touches",
          "commands"
        ],
        "properties": {
          "ac": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "touches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "description": "Exact shell commands, each one as a shell would run it, never a description. The engine runs every entry as written.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "change_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_artifact",
          "proposed_text",
          "rationale",
          "evidence"
        ],
        "properties": {
          "target_artifact": {
            "type": "string",
            "description": "The document id alone, such as SPEC-M1 or TEST-PLAN-M1, with no @version or #section."
          },
          "target_section": {
            "type": "string",
            "description": "The slug of the heading whose text you would replace, such as risks. Name this or target_ac, not both."
          },
          "target_ac": {
            "type": "string",
            "description": "A criterion id, such as AC-3. On a Spec, proposed_text is that criterion's new text, which the stakeholder decides. On a Test Plan, proposed_text is that criterion's new commands, one exact shell command per line."
          },
          "proposed_text": {
            "type": "string",
            "description": "The whole replacement for that section, criterion text or list of commands."
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
