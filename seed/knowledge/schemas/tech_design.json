{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tech Design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "tickets"
  ],
  "properties": {
    "body": {
      "type": "string"
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "specialty",
          "ac_refs",
          "touches",
          "depends_on",
          "definition_of_done",
          "inputs",
          "size",
          "body"
        ],
        "properties": {
          "key": {
            "description": "T-1, T-2 and so on.",
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "specialty": {
            "description": "A role that can edit the repository. Use engineer unless the team has another.",
            "type": "string"
          },
          "ac_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "touches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "definition_of_done": {
            "description": "Exact shell commands that prove the ticket worked, each one as a shell would run it, never a description.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "description": "Artifact pins: an id, @ and its version, then optionally # and a section's slug, its heading in lower case with hyphens. For example SPEC-M1@1#ac-1 or SPEC-M1@1#what-it-must-do.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "size": {
            "enum": [
              "S",
              "M",
              "L"
            ]
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "change_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_artifact",
          "proposed_text",
          "rationale",
          "evidence"
        ],
        "properties": {
          "target_artifact": {
            "type": "string"
          },
          "target_section": {
            "type": "string"
          },
          "target_ac": {
            "type": "string"
          },
          "proposed_text": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
