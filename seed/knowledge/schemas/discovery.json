{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "roadmap",
    "team_proposal",
    "human_requirements",
    "stakeholder_note"
  ],
  "properties": {
    "roadmap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "milestones"
      ],
      "properties": {
        "body": {
          "type": "string"
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "title",
              "goal"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string"
              },
              "goal": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "team_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string"
        }
      }
    },
    "human_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string"
        }
      }
    },
    "stakeholder_note": {
      "type": "string"
    },
    "change_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_artifact",
          "proposed_text",
          "rationale",
          "evidence"
        ],
        "properties": {
          "target_artifact": {
            "type": "string"
          },
          "target_section": {
            "type": "string"
          },
          "target_ac": {
            "type": "string"
          },
          "proposed_text": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
